# Public — safe to expose to the browser
NEXT_PUBLIC_SITE_URL=https://codeconsultingstudio.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server secrets — never expose to the browser, never commit real values
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Inbox that gets a notification email on every new lead. Only used when
# RESEND_API_KEY is also set — both are optional (doc 16 §2).
LEAD_NOTIFY_EMAIL=

# CRM sync (HubSpot). Both optional — until both are set, syncLeadToCRM()
# resolves to a silent no-op provider automatically (see docs/LEAD_
# MANAGEMENT.md). The custom `ccs_*` contact properties this provider
# writes must be created in the target HubSpot portal first — see
# src/lib/crm/HubSpotProvider.ts.
CRM_API_KEY=
CRM_PORTAL_ID=

# Search intelligence (Insights Checkpoint 6). Both groups optional —
# until at least one is fully set, the "Refresh from Google/Bing" action
# in /admin/insights/opportunities reports "no provider configured"
# rather than silently doing nothing (see src/features/content-
# intelligence/keywords/ingest.ts).
#
# Google Search Console: a service account with access granted to the
# target property (Search Console → Settings → Users and permissions).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
#
# Bing Webmaster Tools: an API key from Webmaster Tools → Settings → API access.
BING_WEBMASTER_API_KEY=
BING_WEBMASTER_SITE_URL=

# AI editorial pipeline (Insights Checkpoint 7). Silent no-op — every
# stage in src/features/content-intelligence/{research,generation,
# localisation}/ fails with a clear "not configured" result, never
# silently — until ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
# Optional overrides — see src/features/content-intelligence/generation/
# AnthropicProvider.ts for defaults.
CONTENT_AI_MODEL=
CONTENT_AI_MAX_OUTPUT_TOKENS=
# Cost control (src/features/content-intelligence/generation/
# costGuard.ts). Defaults to 0 (blocks every AI call) until set — this
# is deliberately fail-closed, not fail-open.
CONTENT_AI_MONTHLY_BUDGET_USD=
# Your actual per-1K-token rates for the configured model — the
# defaults in costGuard.ts are placeholders, not a live pricing feed.
CONTENT_AI_INPUT_COST_PER_1K=
CONTENT_AI_OUTPUT_COST_PER_1K=

# Automation / scheduler (Insights Checkpoint 8). CRON_SECRET is
# required — /api/v1/scheduler/publish refuses every request until it's
# set (fail closed, not fail open). Point an external scheduler (Vercel
# Cron Jobs or any cron-capable service) at that URL once a day, sending
# `Authorization: Bearer <CRON_SECRET>`; Vercel Cron Jobs adds this
# header automatically when CRON_SECRET is set in the project env.
CRON_SECRET=
# Optional — defaults documented in src/features/insights/publishing/
# cadence.ts (18:00 UTC, minimum 2 days apart).
CONTENT_PUBLISH_HOUR_UTC=
CONTENT_PUBLISH_MIN_INTERVAL_DAYS=
# Optional — enables IndexNow submission (src/features/insights/seo/
# indexNow.ts) after the scheduler publishes something. Generate any
# random 32+ character hex string for this; it doubles as the file
# served at /api/indexnow-key.txt.
INDEXNOW_KEY=

# Content refresh (Insights Checkpoint 9). Optional — defaults to 180
# days if unset. See src/features/content-intelligence/refresh/
# staleness.ts.
CONTENT_REFRESH_STALE_DAYS=
