# Public — safe to expose to the browser
NEXT_PUBLIC_SITE_URL=https://codeconsultingstudio.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server secrets — never expose to the browser, never commit real values
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Inbox that gets a notification email on every new lead. Only used when
# RESEND_API_KEY is also set — both are optional (doc 16 §2).
LEAD_NOTIFY_EMAIL=

# CRM sync (HubSpot). Both optional — until both are set, syncLeadToCRM()
# resolves to a silent no-op provider automatically (see docs/LEAD_
# MANAGEMENT.md). The custom `ccs_*` contact properties this provider
# writes must be created in the target HubSpot portal first — see
# src/lib/crm/HubSpotProvider.ts.
CRM_API_KEY=
CRM_PORTAL_ID=
